const SEED_USERS = [
  {id:'U-ADMIN', username:'admin', name:'System Administrator', role:'Admin', active:true, password:'Admin@12345'},
  {id:'U-CEO', username:'ceo', name:'CEO — Appletree Interiors', role:'CEO', active:true, password:'Ceo@12345'},
