// ---------- Phase 6B: business-process enums (one place, not scattered through UI) ----------
const LEAD_STATUSES = ['NEW','CONTACTED','QUALIFIED','ESTIMATION','QUOTATION','NEGOTIATION','WON','LOST','ON HOLD'];
